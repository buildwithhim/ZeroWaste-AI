# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/

# Build
dist/
build/

# Environment
# Everything .env* is ignored, then .env.example is re-included: it is the
# committed template and must never contain real values. Ignoring only ".env"
# would let .env.production or .env.local be committed by accident, which is
# exactly the file most likely to hold a working credential.
.env
.env.*
!.env.example

# Runtime feedback data (regenerate with: npm run seed:feedback)
data/feedback.json
data/feedback.json.tmp
data/feedback_signals.json
data/feedback_signals.json.tmp

# SmartQ invoice ingestion runtime data.
# The vault holds original invoice PDFs and must never be committed; the
# database, import history and audit trail are per-environment state.
data/invoice_vault/
data/invoices.json
data/invoices.json.tmp
data/invoice_imports.json
data/invoice_imports.json.tmp
data/invoice_audit.log
data/invoice_orders_dataset.csv
data/invoice_orders_dataset.csv.tmp
data/test_invoices/

# VS Code
.vscode/

# Test artifacts
coverage/
e2e/.artifacts/
e2e/.report/
playwright-report/
test-results/

