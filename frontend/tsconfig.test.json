{
  // Type-checking for the test suite.
  //
  // Deliberately NOT a project reference of tsconfig.json. `npm run build`
  // runs `tsc -b`, and a production build should not be able to fail on
  // test-only code -- especially code excluded from the Docker context, which
  // would make the image build fail on files it does not contain.
  //
  // It includes all of src, not just the test files, because the tests import
  // the components they exercise and a project must list every file in its
  // program. The tests are still genuinely checked -- they were not before,
  // since `tsc --noEmit` against the solution config compiled nothing at all.
  //
  // Run with: npm run typecheck
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // vitest is configured with globals: true, so describe/it/expect are
    // ambient rather than imported.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  "exclude": []
}