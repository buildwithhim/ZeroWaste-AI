{
  "name": "zerowaste-ai",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report e2e/.report",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:config": "docker compose -f docker-compose.yml -f docker-compose.prod.yml config --quiet",
    "prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "migrate": "npm --prefix backend run migrate",
    "migrate:check": "npm --prefix backend run migrate:check",
    "seed:feedback": "node scripts/seed_feedback.js",
    "seed:operations": "node scripts/seed_operations.js",
    "invoices:fixtures": "python scripts/make_test_invoice.py",
    "start:backend": "npm --prefix backend start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwithhim/ZeroWaste-AI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/buildwithhim/ZeroWaste-AI/issues"
  },
  "homepage": "https://github.com/buildwithhim/ZeroWaste-AI#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
