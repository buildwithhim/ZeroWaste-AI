# ZeroWaste AI -- environment configuration
#
# Copy to .env and fill in. `.env` is gitignored; this file is committed and
# must therefore contain NO REAL VALUES. Every secret below is a placeholder or
# a generation command, never a working credential.
#
#   cp .env.example .env
#
# The backend validates all of this at boot via backend/lib/config.js and exits
# with code 78 (EX_CONFIG) listing every problem at once if production rules are
# violated. It does not start with a bad configuration and warn -- a service
# that boots with a default admin token is worse than one that does not boot.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | test | production
# Setting this to production activates every safety rule in validateConfig().
NODE_ENV=development

PORT=5000
HOST=0.0.0.0

# Where the JSON stores and the local invoice vault live. Required in
# production, because the default resolves relative to the source tree, which
# inside a container is wiped on every deploy.
ZEROWASTE_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
#
# Both have committed development defaults so a fresh clone runs. Both are
# rejected in production by exact match, along with anything shorter than 32
# characters. Generate with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Shared bearer token for every admin route. NOTE: this is a single shared
# secret, not per-user authentication -- see the C2 blocker in
# docs/DEPLOYMENT.md. It must not be reused across environments.
ADMIN_TOKEN=

# Pepper for the employee-ID hash used to pseudonymise feedback. Changing it
# after data exists orphans every previous hash and silently breaks the
# "have I already responded" check, so treat it as permanent per environment
# and rotate only with a re-hash migration.
FEEDBACK_HASH_SALT=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
#
# Comma-separated exact origins, scheme included. In production an empty list,
# "*", or any plaintext http:// origin is rejected at boot.
#
# When the frontend is served by the nginx container it proxies the API on the
# same origin, so no cross-origin request is made and this list can stay empty
# outside production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Only enable with an explicit origin allowlist. Credentialed requests plus a
# wildcard is a combination browsers refuse, and for good reason.
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# Optional today. The application still reads and writes the JSON stores; the
# schema and migrations exist so the cutover is a code change rather than an
# infrastructure project. See backend/lib/db/repositories.js.
#
# postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Used by docker-compose to provision the local Postgres container.
POSTGRES_USER=zerowaste
POSTGRES_PASSWORD=
POSTGRES_DB=zerowaste

# ---------------------------------------------------------------------------
# Object storage (SmartQ invoice vault)
# ---------------------------------------------------------------------------
#
# The vault holds the original PDFs, addressed by SHA-256 content hash. "local"
# writes them to ZEROWASTE_DATA_DIR, which is correct for one container with a
# volume and quietly wrong for two -- a replica that did not receive the upload
# cannot serve it back. Production therefore rejects "local" unless
# STORAGE_ALLOW_LOCAL=true says the single-replica constraint is understood.
STORAGE_DRIVER=local
STORAGE_ALLOW_LOCAL=false

STORAGE_BUCKET=zerowaste-invoices
STORAGE_REGION=ap-south-1
STORAGE_PREFIX=invoice-vault

# Set for MinIO or another S3-compatible gateway; leave empty for AWS S3.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=true

# Prefer leaving these empty in production and attaching an instance role,
# a Kubernetes service account, or another ambient identity -- the SDK's default
# credential chain picks it up, and there is then no long-lived key to leak.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
#
# Unset: the backend spawns predict.py and parse_invoices.py as child
# processes. This is what development and the entire test suite use.
# Set: the backend calls the containerised FastAPI service over HTTP, which is
# the production shape and the only one that scales independently.
#
# The AI service performs NO authentication. It must never be published to the
# internet -- keep it on an internal network reachable only by the backend.
AI_SERVICE_URL=

AI_SERVICE_TIMEOUT_MS=20000

# Only used in spawn mode. Auto-detected from .venv, falling back to python3.
PYTHON_PATH=

# Where the AI service reads model artefacts and feedback signals from. This
# MUST resolve to the same storage as the backend's ZEROWASTE_DATA_DIR:
# predict.py re-reads feedback_signals.json on every request, and the backend
# is what writes it. Separate directories means forecasts silently stop
# responding to feedback.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug | info | warn | error. Defaults to info in production, debug otherwise.
LOG_LEVEL=debug

# json | pretty. Defaults to json in production. Log aggregators parse json;
# pretty is for humans reading a terminal.
LOG_FORMAT=pretty

SERVICE_NAME=zerowaste-backend

# Stamped into every log line so a report can be tied to a release. CI should
# set this to the commit SHA.
APP_VERSION=

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------

# Enable only when actually behind a proxy that sets X-Forwarded-For. Trusting
# the header when nothing overwrites it lets any client forge its own IP.
TRUST_PROXY=false

# Invoice uploads are multipart and bounded separately by multer; this caps
# JSON bodies.
BODY_LIMIT=1mb

# How long to keep serving in-flight requests after SIGTERM, before closing the
# listener. Must exceed the load balancer's deregistration delay or the last
# few requests are cut off mid-response.
SHUTDOWN_GRACE_MS=10000

# ---------------------------------------------------------------------------
# Frontend (build time)
# ---------------------------------------------------------------------------
#
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle, which
# is served to every visitor. NEVER put a secret behind a VITE_ prefix.
#
# Empty means same-origin relative requests, which is what the nginx container
# proxies. Set it only when the API is genuinely on another origin.
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Local stack only (docker-compose.yml)
# ---------------------------------------------------------------------------

MINIO_ROOT_USER=zerowaste
MINIO_ROOT_PASSWORD=

# Guard for scripts/seed_*.js. They call replaceAll and refreshSignals, so they
# replace real history with fabricated data. Only ever set this to
# "yes-i-am-sure" against a disposable environment.
ALLOW_DESTRUCTIVE_SEED=
